# SmartNest Environment Configuration
# Copy this file to .env and adjust values as needed.

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Simulation settings
SIMULATION_NAME=smartnest_assignment_1_2

# MongoDB Atlas (Assignment: database layer).
# Put the REAL values in backend/.env only; .env is git-ignored. Never commit credentials.
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/
MONGODB_DATABASE=smartnest

# Optional tuning (defaults shown)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_MAX_POOL_SIZE=50

# Gemini API (Assignment 4.2). Put the REAL key in backend/.env only; never commit it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your_gemini_api_key>
# Optional. Models are retired over time; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=60

# SerpApi Google Shopping (primary live product discovery). Put the REAL key in backend/.env only.
# Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=<your_serpapi_api_key>
# Optional tuning (defaults shown)
# SERPAPI_TIMEOUT_SECONDS=20
# SERPAPI_MAX_RESULTS=10
# SERPAPI_MAX_DETAIL_CALLS=3
# SERPAPI_CACHE_TTL_HOURS=6

# Application (all optional)
# SMARTNEST_ALLOW_SIMULATED=auto   # auto: labelled sample listings only when no real snapshot exists
# SMARTNEST_USE_GEMINI=auto
# SMARTNEST_USE_ATLAS=0            # 1: persist chat sessions in MongoDB Atlas (home_projects)
# SMARTNEST_CORS_ORIGINS=http://localhost:5173
# SMARTNEST_ALLOW_LIVE_SEARCH=0    # 1: show a working "Search live" button (spends SerpApi requests, capped by SERPAPI_LIFETIME_LIMIT if set)

# SerpApi request cap (local safety limit, counted in .serpapi_usage.json).
# A number caps TOTAL requests; the word "unlimited" removes the cap ON PURPOSE (an empty/absent value makes the
# capture script refuse to run, because it may mean this file was not loaded). SerpApi's own plan limits still apply.
# SERPAPI_LIFETIME_LIMIT=unlimited
